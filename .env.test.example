# Copy this file to .env.test.local and fill in real values from your own
# dev data, then run: npm run test:security
# .env.test.local is gitignored (matches the existing .env*.local pattern) —
# never commit real tokens.

BASE_URL=http://localhost:3000

# A brand account's JWT (same token format as auth_token in localStorage
# after logging in — see src/app/api/auth/login/route.ts).
BRAND_A_TOKEN=

# A creator account's JWT. Must already have a conversation with Brand A
# (CONVERSATION_ID below).
CREATOR_A_TOKEN=

# A second, unrelated creator account's JWT. Must NOT be a party to
# CONVERSATION_ID and must NOT be on PRIVATE_CAMPAIGN_ID's tracker — this is
# the account every negative check tries to use to reach someone else's data.
CREATOR_B_TOKEN=

# An existing conversation id between Brand A and Creator A.
CONVERSATION_ID=

# Optional: a storage path (the "path" field) of an existing message
# attachment in that conversation. Leave blank to skip that one check.
ATTACHMENT_PATH=

# An existing campaign id with visibility set to "private". Creator B must
# NOT have a campaign_creators row on it.
PRIVATE_CAMPAIGN_ID=

# Optional (Phase 4 — contracts/reporting checks, skipped if blank):

# A campaign_creators row id where Creator A is the creator and Brand A is
# the owning brand. Used to check offers/deliverables/events/calendar never
# leak charge_amount/brand_notes/client_name, and that Creator B gets 404 on
# every sub-resource of a row they're not party to.
#
# The payout-details checks below additionally want this row to have BOTH
# a fully_signed contract AND an open (not confirmed/cancelled) payment —
# that combination drifts over time as dev-data payments get marked paid,
# so if those checks start reporting SKIP instead of running, find a row
# that currently satisfies both:
#   SELECT cc.id AS campaign_creator_id
#   FROM campaign_creators cc
#   JOIN campaign_contracts ct ON ct.campaign_creator_id = cc.id AND ct.status = 'fully_signed'
#   JOIN creator_payments cp ON cp.campaign_creator_id = cc.id AND cp.status NOT IN ('confirmed', 'cancelled')
#   LIMIT 1;
CAMPAIGN_CREATOR_ID=

# A campaign_contracts id on CAMPAIGN_CREATOR_ID above (any status). Used to
# check only the two parties (+ admin) can read it, and its body never
# contains client_name/charge_amount/brand_notes.
CONTRACT_ID=

# An active campaign_share_links token (show_results on gives the most
# coverage, but either works). Used to check the public share response never
# contains payout_amount, profit, or brand_notes.
SHARE_TOKEN=

# Optional (Phase 5 — payments checks, skipped if blank):

# A creator_payments id on CAMPAIGN_CREATOR_ID above (any status). Used to
# check Creator A can't mark it as paid themselves, and Creator B gets 404
# resolving its proof signed URL.
#
# The admin payout-masking check (Phase 7B) additionally wants this
# payment's creator to have a payout method on file, otherwise there's
# nothing for that check to verify is masked and it reports SKIP. Find one:
#   SELECT cp.id AS payment_id
#   FROM creator_payments cp
#   JOIN campaign_creators cc ON cc.id = cp.campaign_creator_id
#   JOIN payout_methods pm ON pm.creator_id = cc.creator_id AND pm.is_default = true
#   LIMIT 1;
PAYMENT_ID=

# A payout_methods id belonging to Creator A (CREATOR_A_TOKEN). Used to
# check Creator B gets 404 trying to update it.
PAYOUT_METHOD_ID=

# A second campaign_creators id of Brand A's that does NOT currently
# satisfy both payout-details preconditions above (no fully_signed
# contract, or no open payment, or both). Only needed if
# CAMPAIGN_CREATOR_ID itself happens to satisfy both in your dev data —
# gives "Brand A gets 404 on payout-details without both a fully signed
# contract and an open payment" a row to test instead of skipping.
UNSIGNED_CAMPAIGN_CREATOR_ID=

# ──────────────────────────────────────────────────────────────────────────
# Used only by scripts/race-check.mjs (node scripts/race-check.mjs), a
# separate script from security-check.mjs. It WRITES DATA — only ever point
# it at disposable test rows, never real data.
# ──────────────────────────────────────────────────────────────────────────

# A campaign_creators id owned by Brand A (BRAND_A_TOKEN) — the row both
# RACE_PAYMENT_ID and RACE_SPLIT_PAYMENT_ID below belong to.
RACE_CAMPAIGN_CREATOR_ID=

# A creator_payments id on RACE_CAMPAIGN_CREATOR_ID, status "due" or
# "disputed". Fires two concurrent mark-paid calls at it and asserts the
# final record lands on exactly one of the two references sent, never both,
# never neither.
RACE_PAYMENT_ID=

# A creator_payments id on RACE_CAMPAIGN_CREATOR_ID, type "full" and status
# "scheduled" (not already split). Fires two concurrent split calls at it
# and asserts exactly one succeeds (200) and one is rejected (409), with
# exactly one new upfront/final pair left behind, not two.
RACE_SPLIT_PAYMENT_ID=

# Optional (Phase 6A — notifications checks, skipped if blank):

# A notifications id belonging to Creator A (CREATOR_A_TOKEN), currently
# unread. Used to check Creator B can't read it (it's absent from their own
# list) and that Creator B marking it read/archived has no real effect on
# Creator A's copy.
CREATOR_A_NOTIFICATION_ID=

# Optional (Phase 6B — email checks, skipped if blank):

# A fresh, unused password-reset token's RAW value (not its hash) for a
# DISPOSABLE test account — trigger POST /api/auth/forgot-password for
# that account, then copy the token out of the server console log (no
# RESEND_API_KEY set) or the actual email. WRITES DATA: running this check
# resets that account's password to a fixed test value
# (PASSWORD_RESET_TEST_NEW_PASSWORD in the script). Never use a real
# account's token here.
PASSWORD_RESET_TOKEN=

# Optional (Phase 7A — admin hardening checks, skipped if blank):

# Admin auth is an HttpOnly cookie (`auth_token`), not a bearer token you
# can mint by hand — the admin UI never sends an Authorization header at
# all, and the script now sends ADMIN_TOKEN/SUPER_ADMIN_TOKEN the same
# way: as `Cookie: auth_token=<value>`. (The /api/admin/* middleware gate
# happens to also accept a Bearer header today, but that's not what any
# real client sends, so don't rely on it — and don't hand-sign a JWT with
# the role you want, either: that's exactly how this value silently ended
# up pointing at a non-admin account before, which made every "admin gets
# 403" check pass for the wrong reason instead of actually testing
# anything. Always pull the real value out of a real admin session.)
#
# To get it: log in at /admin/login with a real admin account in your
# browser, then open DevTools → Application → Cookies → this site →
# copy the value of `auth_token`. Repeat with a super_admin account for
# SUPER_ADMIN_TOKEN below. Each is valid for 4 hours (the admin login's
# own session length) — if checks that use it start getting 403s instead
# of running, the cookie has expired; log in again and re-copy it.
#
# An admin account's auth_token cookie value, role "admin" (not
# "super_admin"). Used to check it gets 403 on super_admin-only actions
# (delete, role change, settings), and that suspending a user through it
# writes a real activity_logs row.
ADMIN_TOKEN=

# A super_admin account's auth_token cookie value (same copy-from-DevTools
# steps as ADMIN_TOKEN above, logged in as a super_admin instead). Used as
# a positive control proving the super_admin gate is actually reachable,
# and gates the admin payments/leak checks alongside ADMIN_TOKEN.
SUPER_ADMIN_TOKEN=

# A DISPOSABLE test user's id (any user_type) for ADMIN_TOKEN to suspend
# then immediately reactivate. WRITES DATA, though the check restores the
# account's is_active state before it finishes either way. Never use a
# real account's id here.
ADMIN_TEST_TARGET_USER_ID=

# Optional (Phase 7B — admin visibility checks, skipped if blank):

# A DISPOSABLE test user's id (any user_type, must not equal Creator A's
# own user id). WRITES DATA: fires up to 6 real POST /api/reports calls
# from CREATOR_A_TOKEN against this id to prove the 5/hour per-reporter
# rate limit actually returns 429. Never use a real account's id here.
RATE_LIMIT_TEST_REPORTED_USER_ID=
