# ===========================================
# INFOISHAI MARKETPLACE - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Authentication (custom JWT — not Supabase Auth, see src/middleware.ts)
JWT_SECRET=your-secret-key-min-32-characters-long

# Encrypts creator payout details (bank/Wise/Payoneer/PayPal account info) at
# rest — AES-256-GCM, see src/lib/payments/crypto.ts. Server-only, never
# exposed to the client. Generate a real one with:
#   openssl rand -base64 32
# Changing this key makes every previously stored payout method
# undecryptable — treat it like JWT_SECRET, back it up, never rotate
# casually.
PAYOUT_ENCRYPTION_KEY=generate-with-openssl-rand--base64-32

NODE_ENV=development

# ===========================================
# Optional / not yet wired up in code
# ===========================================

# Analytics (Google Analytics 4)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email (legacy, never wired up — superseded by Resend below)
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_EMAIL=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=

# Email (Resend) — Phase 6B. src/lib/email/send.ts calls Resend's REST API
# directly via fetch. If RESEND_API_KEY is unset, emails are logged to the
# server console instead of sent (local dev).
RESEND_API_KEY=
EMAIL_FROM=Infoishai <notifications@yourdomain.com>

# Used to build absolute links in emails (buttons, unsubscribe) and to
# protect the cron routes under /api/cron/*.
NEXT_PUBLIC_APP_URL=https://infoishai.com
CRON_SECRET=

# Brand "Book a call" link (Calendly) on the Managed Service page (/pricing).
# Must be an https URL; the button is hidden when this is unset.
NEXT_PUBLIC_BRAND_BOOKING_URL=
