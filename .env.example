# ===========================================
# INFOISHAI MARKETPLACE - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Authentication (custom JWT — not Supabase Auth, see src/middleware.ts)
JWT_SECRET=your-secret-key-min-32-characters-long

# Encrypts creator payout details (bank/Wise/Payoneer/PayPal account info) at
# rest — AES-256-GCM, see src/lib/payments/crypto.ts. Server-only, never
# exposed to the client. Generate a real one with:
#   openssl rand -base64 32
# Changing this key makes every previously stored payout method
# undecryptable — treat it like JWT_SECRET, back it up, never rotate
# casually.
PAYOUT_ENCRYPTION_KEY=generate-with-openssl-rand--base64-32

NODE_ENV=development

# ===========================================
# Optional / not yet wired up in code
# ===========================================

# Analytics (Google Analytics 4)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email (not yet wired up in code)
# SMTP_SERVER=
# SMTP_PORT=
# SMTP_EMAIL=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=
